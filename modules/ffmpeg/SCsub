#!/usr/bin/env python
from misc.utility.scons_hints import *

import gdextension_build.ffmpeg_download as ffmpeg_download
from misc.utility.color import print_info

Import("env")

if env["platform"] == "linuxbsd":
    if "RPATH" not in env:
        env.Append(RPATH=env.Literal("\\$$ORIGIN"))
    env.Append(LINKFLAGS=["-Wl,--disable-new-dtags"])

env_ffmpeg = env.Clone()

module_obj = []

excluded = []

sources = [x for x in Glob("*.cpp") if str(x) not in excluded]

ffmpeg_path = env["ffmpeg_path"]

# Vulkan Video decoding is compiled in when ffmpeg_path holds FFmpeg 9 or newer
# (avutil 61). Whether the library was built with Vulkan is only known at
# runtime; without it, playback stays on the software path. The GDExtension has
# its own SConstruct and never enables this.
gpu_decode = env.get("ffmpeg_gpu_decode", "auto")
if gpu_decode not in ("auto", "yes", "no"):
    raise RuntimeError("ffmpeg_gpu_decode must be auto, yes or no")
gpu_decode_unsupported = None
if env["platform"] not in ("linuxbsd", "windows") or env["arch"] != "x86_64":
    gpu_decode_unsupported = "it is only supported on x86_64 Linux and Windows"
elif not env["vulkan"]:
    gpu_decode_unsupported = "it requires a Vulkan-enabled engine build"
elif int(ffmpeg_download.get_ffmpeg_versions(ffmpeg_path)["avutil"]) < 61:
    gpu_decode_unsupported = f"it requires FFmpeg 9 or newer in ffmpeg_path ({ffmpeg_path})"
if gpu_decode == "yes" and gpu_decode_unsupported:
    raise RuntimeError(f"ffmpeg_gpu_decode=yes, but {gpu_decode_unsupported}")
gpu_decode_enabled = gpu_decode != "no" and not gpu_decode_unsupported
if gpu_decode_enabled:
    env_ffmpeg.Append(CPPDEFINES=["FFMPEG_GPU_DECODE_ENABLED"])
elif gpu_decode == "auto":
    print_info(f"FFmpeg: Vulkan Video decoding not compiled in, because {gpu_decode_unsupported}.")
if env.get("ffmpeg_gpu_tests", "no") == "yes":
    if not gpu_decode_enabled:
        raise RuntimeError("ffmpeg_gpu_tests=yes requires Vulkan Video decoding support (see ffmpeg_gpu_decode)")
    env_ffmpeg.Append(CPPDEFINES=["FFMPEG_GPU_TESTS_ENABLED"])

# This define is intentionally absent from the GDExtension SConstruct.
env_ffmpeg.Append(CPPDEFINES=["FFMPEG_ENGINE_MODULE"])

env_ffmpeg.Prepend(CPPPATH=f"{ffmpeg_path}/include")
env_ffmpeg.Prepend(CPPDEFINES="ENABLE_STREAM_INFO")
env.Append(LIBPATH=[f"{ffmpeg_path}/lib"])

ffmpeg_libs = ["avcodec", "avfilter", "avformat", "avutil", "swresample", "swscale"]

if env.msvc:
    # MSVC: Think Different(tm)
    env.Append(LINKFLAGS=[x + ".lib" for x in ffmpeg_libs])
    env_ffmpeg.Append(CXXFLAGS=["/std:c++20"])
else:
    # mingw
    env.Append(LIBS=ffmpeg_libs)

if env["platform"] == "android":
    lib_arch_dir = ""
    if env["arch"] == "arm32":
        lib_arch_dir = "armeabi-v7a"
    elif env["arch"] == "arm64":
        lib_arch_dir = "arm64-v8a"
    elif env["arch"] == "x86_32":
        lib_arch_dir = "x86"
    elif env["arch"] == "x86_64":
        lib_arch_dir = "x86_64"
    else:
        print_warning("Architecture not suitable for embedding into APK; keeping .so at \\bin")

    lib_type_dir = ""

    if env.dev_build:
        lib_type_dir = "dev"
    elif env.debug_features:
        lib_type_dir = "debug"
    else:  # Release
        lib_type_dir = "release"

    arm_lib_target = f"#platform/android/java/lib/libs/{lib_type_dir}/{lib_arch_dir}"

    print("ARMLIB!", arm_lib_target)
    ffmpeg_install_action_android = ffmpeg_download.ffmpeg_install(env_ffmpeg, arm_lib_target, ffmpeg_path)
else:
    ffmpeg_install_action = ffmpeg_download.ffmpeg_install(env_ffmpeg, "#bin", ffmpeg_path)

env_ffmpeg.GLSL_HEADER("yuv_to_rgb.glsl")
if gpu_decode_enabled:
    env_ffmpeg.GLSL_HEADER("vulkan_yuv_to_rgb.glsl")
    if env.get("ffmpeg_gpu_tests", "no") == "yes":
        env_ffmpeg.GLSL_HEADER("vulkan_validate_rgb.glsl")
env_ffmpeg.Depends(Glob("*.glsl.gen.h"), ["#glsl_builders.py"])

# env_ffmpeg.Append(CPPDEFINES=["FFMPEG_MT_GPU_UPLOAD"])
if ARGUMENTS.get("ffmpeg_shared", "no") == "yes":
    # Shared lib compilation
    env_ffmpeg.Append(CCFLAGS=["-fPIC"])
    env_ffmpeg["LIBS"] = FFMPEG_LIBS
    shared_lib = env_ffmpeg.SharedLibrary(target="#bin/ffmpeg", source=sources)
    shared_lib_shim = shared_lib[0].name.rsplit(".", 1)[0]
    env.Append(LIBPATH=["#bin"])
    env.Append(LIBS=[shared_lib_shim])
else:
    env_ffmpeg.add_source_files(module_obj, sources)
    env.modules_sources += module_obj
